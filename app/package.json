{
  "name": "ulanzi-deck-open",
  "productName": "Ulanzi Deck Open",
  "version": "0.12.0",
  "description": "Open-source control for Ulanzi D200 decks",
  "main": "main.js",
  "type": "commonjs",
  "author": "",
  "license": "MIT",
  "scripts": {
    "build:native": "sh scripts/build-helpers.sh",
    "prepackage": "sh scripts/build-helpers.sh",
    "start": "electron .",
    "dev": "electron . --dev",
    "package": "electron-packager . 'Ulanzi Deck Open' --platform=darwin --arch=arm64 --out=dist --overwrite --icon=build/icon --app-bundle-id=com.edufalcao.ulanzideckopen --prune=true --ignore='^/(dist|build/icon\\.iconset|test|scripts|native|docs|build/helpers|eslint\\.config\\.js|\\.github)'",
    "package:all": "electron-packager . 'Ulanzi Deck Open' --platform=darwin --arch=universal --out=dist --overwrite --icon=build/icon --app-bundle-id=com.edufalcao.ulanzideckopen --prune=true --ignore='^/(dist|build/icon\\.iconset|test|scripts|native|docs|build/helpers|eslint\\.config\\.js|\\.github)' --osx-universal.x64ArchFiles='Contents/Resources/app.asar.unpacked/node_modules/node-hid/prebuilds/**'",
    "postpackage": "sh scripts/after-package.sh",
    "install-app": "sh scripts/install.sh",
    "readme-screenshot": "sh scripts/readme-screenshot.sh",
    "test": "node --test \"test/*.test.js\"",
    "make:dmg": "sh scripts/make-dmg.sh",
    "prepackage:all": "sh scripts/build-helpers.sh",
    "postpackage:all": "sh scripts/after-package.sh",
    "lint": "eslint .",
    "prestart": "sh scripts/build-helpers.sh",
    "predev": "sh scripts/build-helpers.sh",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "node-hid": "^3.4.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^26.6.6",
    "electron": "^45.1.0",
    "eslint": "^10.14.0",
    "typescript": "^7.0.2"
  }
}
